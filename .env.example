# Caminho para o arquivo do banco de dados SQLite
DB_PATH=./data/wc2026.db

# Segredo para assinatura JWT HS256 (mínimo 32 bytes em produção)
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-bytes

# TTL do token JWT (ex.: 1h, 30m)
JWT_TTL=1h

# Porta gRPC do servidor
GRPC_PORT=50051

# Ambiente de execução: "development" habilita gRPC reflection (introspecção da
# API por ferramentas genéricas). Qualquer outro valor (default "production")
# mantém o reflection desligado. Use "development" ou "dev" apenas em dev.
APP_ENV=development
